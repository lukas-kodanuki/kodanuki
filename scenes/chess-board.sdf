import "standard.sdf";

render {
	width     = 1920;
	height    = 1200;
	tolerance = 2;
}

camera {
	eye    = [-4, -7, 4];
	target = [0, 0, 0.3];
	fov    = 0.7;
}

grade {
	exposure = 1;
	curve    = filmic;
}

sky gradient {
	zenith  = [0.05, 0.13, 0.34];
	horizon = [0.26, 0.40, 0.62];
	ground  = [0.10, 0.09, 0.08];
}

light directional {
	direction = [0.4, -0.5, 0.7];
	power     = [2.4, 2.3, 2.1];
}

light sphere {
	at     = [-2.2, -1.6, 3];
	radius = 0.3;
	power  = [18, 17, 15];
}

let white = plastic(#F2EAD8, roughness = 0.35);
let black = plastic(#2A2320, roughness = 0.35);

let foot = -0.01125;

let PAWN = [
	[0, foot],
	[0.2, foot],
	[0.2, 0.05],
	[0.09, 0.13],
	[0.08, 0.25],
	[0.13, 0.29],
	[0.13, 0.33],
	[0.0175, 0.38],
	[0, 0.38],
];

let ROOK = [
	[0, foot],
	[0.23, foot],
	[0.23, 0.05],
	[0.14, 0.15],
	[0.13, 0.38],
	[0.19, 0.45],
	[0.19, 0.5775],
	[0, 0.5775],
];

let BISHOP = [
	[0, foot],
	[0.23, foot],
	[0.23, 0.05],
	[0.1, 0.15],
	[0.09, 0.38],
	[0.15, 0.42],
	[0.15, 0.46],
	[0.09, 0.5],
	[0.123261, 0.633043],
	[0, 0.77],
];

let KNIGHT = [
	[0, foot],
	[0.23, foot],
	[0.23, 0.05],
	[0.11, 0.15],
	[0.1, 0.28],
	[0.16, 0.32],
	[0.16, 0.36],
	[0.085, 0.41],
	[0, 0.41],
];

let QUEEN = [
	[0, foot],
	[0.23, foot],
	[0.23, 0.05],
	[0.12, 0.15],
	[0.11, 0.5],
	[0.17, 0.54],
	[0.17, 0.58],
	[0.11, 0.62],
	[0.12, 0.67],
	[0.196302, 0.802257],
	[0, 0.8125],
];

let KING = [
	[0, foot],
	[0.23, foot],
	[0.23, 0.05],
	[0.12, 0.15],
	[0.11, 0.5],
	[0.17, 0.54],
	[0.17, 0.58],
	[0.11, 0.62],
	[0.12, 0.67],
	[0.18, 0.76],
	[0.18, 0.771577],
	[0, 0.8325],
];

shape pawn() {
	merge(0.02) {
		revolve(PAWN);
		at([0, 0, 0.45]) sphere(0.095);
	}
}

shape rook() {
	cut(0.005) {
		revolve(ROOK);
		with at([0, 0, 0.56]) {
			for i in 0..4 {
				turn(z, i * pi / 2) box([0.4, 0.09, 0.1], 0);
			}
			cylinder(0.1, 0.13);
		}
	}
}

shape bishop(side) {
	merge(0.005) {
		cut(0.005) {
			revolve(BISHOP);
			turn(z, side * pi / 2) at([0, 0, 0.7]) turn(x, side * 0.3)
				at([0, -0.03 * side, 0.02]) box([0.56, 0.04, 0.12], 0);
		}
		at([0, 0, 0.76]) sphere(0.03);
	}
}

shape knight(side) {
	let throat = [0, -0.02 * side, 0.36];
	let nape   = [0, -0.10 * side, 0.60];
	let muzzle = [0, 0.11 * side, 0.62];
	let ear    = [0.045, -0.10 * side, 0.62];
	let tip    = ear + [0.010, -0.03 * side, 0.10];
	merge(0.005) {
		revolve(KNIGHT);
		sweep(throat, nape, 0.12, 0.07);
		sweep(nape, muzzle, 0.086, 0.055);
		for s in [-1, 1] {
			scale([s, 1, 1]) sweep(ear, tip, 0.035, 0.008);
		}
	}
}

shape queen() {
	merge(0.01) {
		cut(0.005) {
			revolve(QUEEN);
			with at([0, 0, 0.82]) {
				for i in 0..8 {
					turn(z, i * pi / 4) box([0.52, 0.06, 0.07], 0);
				}
			}
			at([0, 0, 0.81]) cylinder(0.05, 0.135);
		}
		at([0, 0, 0.83]) sphere(0.05);
	}
}

shape king() {
	merge(0.005) {
		revolve(KING);
		with at([0, 0, 0.88]) turn(x, pi / 2) {
			for i in 0..4 {
				turn(z, i * pi / 2) box([0.124, 0.044, 0.044], 0.005);
			}
		}
	}
}

let board = [
	[1, 8, 1, 1],
	[2, 8, 2, 1],
	[3, 8, 3, 1],
	[5, 8, 5, 1],
	[6, 8, 3, 1],
	[8, 8, 1, 1],
	[1, 7, 0, 1],
	[3, 7, 0, 1],
	[4, 7, 0, 1],
	[6, 7, 0, 1],
	[7, 7, 0, 1],
	[8, 7, 0, 1],
	[6, 6, 2, 1],
	[8, 6, 4, 1],
	[2, 5, 3, 0],
	[5, 4, 0, 0],
	[6, 4, 0, 1],
	[4, 3, 0, 0],
	[6, 3, 2, 0],
	[1, 2, 0, 0],
	[2, 2, 0, 0],
	[3, 2, 0, 0],
	[7, 2, 0, 0],
	[8, 2, 0, 0],
	[1, 1, 1, 0],
	[2, 1, 2, 0],
	[3, 1, 3, 0],
	[4, 1, 4, 0],
	[6, 1, 5, 0],
	[8, 1, 1, 0],
];

shape piece(kind, side) {
	if kind == 0 {
		pawn();
	}
	if kind == 1 {
		rook();
	}
	if kind == 2 {
		knight(side);
	}
	if kind == 3 {
		bishop(side);
	}
	if kind == 4 {
		queen();
	}
	if kind == 5 {
		king();
	}
}

paint(plastic(ramp(checker(8), #5C4636, #C9B89A), roughness = 0.55))
	at([0, 0, -0.07]) box([8, 8, 0.12], 0);

for square in board {
	let side = 1 - 2 * square.w;
	paint(select(square.w, black, white))
		at([square.x - 4.5, square.y - 4.5, 0]) piece(square.z, side);
}
