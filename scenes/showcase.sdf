import "standard.sdf";

render {
	width     = 1280;
	height    = 720;
	tolerance = 2;
	far       = 14;
}

camera {
	eye    = [0, -8.6, 5.2];
	target = [0, 1.7, 0.95];
	fov    = 0.6;
}

grade {
	exposure = 1.1;
	curve    = filmic;
}

sky gradient {
	zenith  = [0.22, 0.26, 0.36];
	horizon = [0.42, 0.42, 0.46];
	ground  = [0.05, 0.05, 0.05];
}

light quad {
	at     = [-4, -3, 6];
	along  = [8, 0, 0];
	across = [0, 3, 1];
	power  = [5, 4.9, 4.7];
}

light sphere {
	at     = [6, -4, 3];
	radius = 0.4;
	power  = [40, 36, 30];
}

function tiles(k) {
	let q = floor(p * k);
	let s = q.x + q.y + q.z;
	return s - 2 * floor(s / 2);
}

function stripes(k) {
	return 0.5 + 0.5 * sin(p.z * k);
}

function rings(k) {
	return 0.5 + 0.5 * cos(length(p.xy) * k);
}

function height(low, high) {
	return clamp((p.z - low) / (high - low), 0, 1);
}

function band(h) {
	return abs(p.z - h);
}

let spacing = 0.95;
let radius  = 0.36;

shape ball(i, row) {
	at([(i - 4.5) * spacing, row * 1.2, row * 0.55 + radius]) sphere(radius);
}

let ground = matte(ramp(tiles(1), [0.30, 0.30, 0.30], [0.42, 0.42, 0.42]));
let step   = matte([0.16, 0.16, 0.18]);

paint(ground) plane([0, 0, 1], 0);
for row in 1..4 {
	paint(step) at([0, row * 0.6 + 1.8, row * 0.275]) box([10.4, 4.8 - row * 1.2, row * 0.55], 0);
}

let colours = [
	#C41E3A,
	#E8731A,
	#F2C12E,
	#7DBA3C,
	#1E9E6A,
	#1FA5C4,
	#2A5BD7,
	#6A3FC1,
	#C13FA8,
	#F4F1EA,
];

for i in 0..10 {
	paint(plastic(colours[i], roughness = 0.35)) ball(i, 0);
}

let red   = [0.70, 0.08, 0.06];
let cream = [0.85, 0.80, 0.68];
let teal  = [0.05, 0.40, 0.45];
let ink   = [0.04, 0.04, 0.06];

paint(matte(ramp(tiles(6), red, cream))) ball(0, 1);
paint(matte(ramp(stripes(30), teal, cream))) ball(1, 1);
paint(matte(ramp(stripes(18), red, cream, teal, ink))) ball(2, 1);
paint(matte(ramp(rings(40), ink, cream))) ball(3, 1);
paint(plastic(ramp(lean([0, 0, 1], 0.4, 0.4), cream, teal), roughness = 0.3)) ball(4, 1);
paint(matte(world(ramp(tiles(3), ink, cream)))) ball(5, 1);
paint(plastic(ramp(height(-0.36, 0.36), red, [0.9, 0.6, 0.1], cream), roughness = 0.4)) ball(6, 1);
paint(metal(ramp(stripes(24), [0.95, 0.75, 0.35], [0.9, 0.9, 0.92]), roughness = 0.2)) ball(7, 1);
paint(matte(ramp(rings(25), teal, red, cream))) ball(8, 1);
paint(plastic(ramp(tiles(10), ink, [0.9, 0.6, 0.1]), roughness = 0.15)) ball(9, 1);

paint(matte([0.75, 0.75, 0.75])) ball(0, 2);
paint(plastic([0.75, 0.10, 0.10], roughness = 0.1)) ball(1, 2);
paint(metal([1, 0.77, 0.34], roughness = 0.08)) ball(2, 2);
paint(metal([0.95, 0.64, 0.54], roughness = 0.4)) ball(3, 2);
paint(glass(refraction = 1.5, absorb = [0, 0, 0], roughness = 0)) ball(4, 2);
paint(glass(refraction = 1.5, absorb = [0.4, 2.5, 6], roughness = 0)) ball(5, 2);
paint(glass(refraction = 1.6, absorb = [0, 0, 0], roughness = 0, dispersion = 0.03)) ball(6, 2);
paint(metal([0.6, 0.6, 0.62], roughness = 0.05, film = [380, 1.45])) ball(7, 2);
paint(glass(refraction = 1.35, absorb = [0.05, 0.08, 0.2], roughness = 0.2, scatter = 14, lean = 0.3)) ball(8, 2);
paint(glass(refraction = 1, absorb = [0, 0, 0], roughness = 0, film = [420, 1.33])) ball(9, 2);

let stone = matte([0.55, 0.52, 0.48]);
let iron  = metal([0.56, 0.57, 0.58], roughness = 0.3);
let rust  = matte([0.45, 0.17, 0.06]);
let gilt  = metal([0.95, 0.75, 0.35], roughness = 0.15);
let blue  = plastic([0.10, 0.25, 0.65], roughness = 0.3);

coat(wet(0.9), below(3 * 0.55 + radius, soft = 0.1)) paint(stone) ball(0, 3);
coat(rust, facing([0, 0, 1], level = 0.3, soft = 0.1, ragged = 0.25, grain = 0.12)) paint(iron) ball(1, 3);
coat(bump(grain, 0.02, span = 0.05)) paint(blue) ball(2, 3);
coat(bump(streak, 0.01, span = 0.03, along = [1, 0, 0])) paint(iron) ball(3, 3);
coat(bump(pits, 0.03, span = 0.1)) paint(stone) ball(4, 3);
coat(gilt, above(3 * 0.55 + radius, soft = 0.05)) paint(blue) ball(5, 3);
coat(tint([1, 0.4, 0.2]), stripes(20)) paint(matte([0.8, 0.8, 0.8])) ball(6, 3);
coat(shade(-0.8), facing([0, -1, 0], level = 0.6, soft = 0.3)) paint(matte(cream)) ball(7, 3);
coat(glow([1, 0.45, 0.15], strength = 6), along(band(3 * 0.55 + radius), 0.06, soft = 0.02)) paint(matte(ink)) ball(8, 3);
coat(polish(1), above(3 * 0.55 + radius)) coat(rough(1), below(3 * 0.55 + radius)) paint(metal([0.9, 0.9, 0.92], roughness = 0.4)) ball(9, 3);

paint(matte(#000000, glow = #FF2080, strength = 8)) at([-3.2, -1.4, 0.12]) turn(x, pi / 2) torus(0.35, 0.05);
paint(matte(#000000, glow = #20C0FF, strength = 6)) at([3.2, -1.4, 0.25]) sphere(0.25);
paint(plastic([0.05, 0.05, 0.05], roughness = 0.2, glow = [1, 0.8, 0.5], strength = 3)) at([0, -1.4, 0.08]) box([1.6, 0.16, 0.16], 0.04);
